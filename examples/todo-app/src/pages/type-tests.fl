// Type system test page — open this in VSCode to verify type checking.
// Lines marked ✓ should have NO errors. Lines marked ✗ SHOULD error.
// ── Import navigation ────────────────────────────────────
// Cmd+click on the path strings to jump to the file

import { Todo, Filter } from "../types"

// ✓ cmd+click "../types" → opens types.fl

import from "../todo"

// ✓ cmd+click "../todo" → opens todo.fl
// ── Member access ────────────────────────────────────────
// Hover over .text, .done — should show string, boolean

let item = Todo { id: "1", text: "Buy milk", done: false }

let _name = item.text

// ✓ hover: string

let _done = item.done

// ✓ hover: boolean
// let _bad = item.nonexistent // ✗ uncomment → "type `Todo` has no field `nonexistent`"
// ── Constructor validation ───────────────────────────────
// Wrong field types should error

let _good = Todo { id: "1", text: "hi", done: false }

// ✓
// let _bad1 = Todo { id: 42, text: "hi", done: false }   // ✗ uncomment → field `id`: expected `string`, found `number`
// let _bad2 = Todo { id: "1", text: "hi", done: "yes" }  // ✗ uncomment → field `done`: expected `boolean`, found `string`
// ── Match arm consistency ────────────────────────────────
// All arms must return the same type

let describeFilter(f: Filter) -> string = {
    match f {
        All -> "all",
        Active -> "active",
        Completed -> "completed",
    }
}

// Uncomment to see error: match arms have incompatible types
// let badMatch(f: Filter) -> string = {
//     match f {
//         All -> "all",
//         Active -> 42,
//         Completed -> "completed",
//     }
// }
// ── Match as conditional ─────────────────────────────────

let abs(x: number) -> number = {
    match x > 0 {
        true -> x,
        false -> 0 - x,
    }
}

// ── Pipe type checking ──────────────────────────────────

let double(x: number) -> number = {
    x * 2
}

let _piped = 5 |> double

// ✓
// let _badPipe = "hi" |> double  // ✗ uncomment → expected `number`, found `string`
// ── Shadowing ────────────────────────────────────────────

let myVal = 5

// let myVal = 10  // ✗ uncomment → already defined and cannot be shadowed
// ── Return type mismatch ─────────────────────────────────

let greet() -> string = {
    "hello"
}

// ✓

// let badReturn() -> string = { 42 }  // ✗ uncomment → return type mismatch

// ── Any word names a property ────────────────────────────
// A record field, a member, a named argument and a JSX attribute all take
// any word. Real JSON and DOM payloads carry these keys. Only a value name
// is restricted.

type FieldMeta = {
    for: string,
    class: string,
    function: string,
    if: string,
}

let fieldMeta = FieldMeta { for: "todo-input", class: "field", function: "add", if: "always" }

let _target = fieldMeta.for

// ✓ hover: string

let _class = fieldMeta.class

// ✓ hover: string

type WidgetMeta = {
    match: string,
    self: string,
}

let widgetMeta = WidgetMeta { match: "exact", self: "widget" }

let _match = widgetMeta.match

// ✓ hover: string — a Floe keyword names a property too
// let for = 1                          // ✗ uncomment → `for` is a reserved word in JavaScript
// let label(for: string) = { "x" }     // ✗ uncomment → same error, on the parameter
// let match = 1                        // ✗ uncomment → `match` is a keyword in Floe
