{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowArbitraryExtensions": true,
    "rootDirs": ["./src", "./.floe/src"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
