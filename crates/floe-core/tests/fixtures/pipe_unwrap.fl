let validate(s: string) -> Result<string, string> = {
    Ok(s)
}

let format(s: string) -> Result<string, string> = {
    Ok(s)
}

let _testPipeUnwrap() -> Result<string, string> = {
    "hello" |> validate?
}

let _testPipeChainUnwrap() -> Result<string, string> = {
    "hello" |> validate |> format?
}

let _testPipeOptionUnwrap() -> Option<number> = {
    [1, 2, 3] |> Array.head?
}

let _testPipeUnwrapOp() -> Result<string, string> = {
    "hello" |>? validate
}

let _testPipeUnwrapOpChain() -> Result<string, string> = {
    "hello" |>? validate |>? format
}

let _testPipeUnwrapOpMixed() -> Result<string, string> = {
    "hello" |> validate |>? format
}

let _testPipeUnwrapOpOption() -> Option<number> = {
    [1, 2, 3] |>? Array.head
}

type Post = {
    id: number,
    title: string,
}

// Two `Promise.await?` steps in one tail expression. Each `?` builds an
// arrow around an `await`, so both arrows must be `async` (#1499).
async let _testAwaitChainTail(url: string) -> Result<Post, Error> = {
    Http.get(url) |> Promise.await? |> Http.json |> Promise.await? |> parse<Post>
}

// One `Promise.await?` step, for the single-step chain.
async let _testAwaitSingleTail(url: string) -> Result<Response, Error> = {
    Ok(Http.get(url) |> Promise.await?)
}
