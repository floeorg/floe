type Payload = { for: string; class: string; function: string; if: string };

function make(): Payload {
  return { for: "name", class: "row", function: "submit", if: "always" };
}

function target(p: Payload): string {
  return p.for;
}

function style(p: Payload): string {
  return p.class;
}
